{
  "name": "acorn",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "rimraf --glob '**/.next' '**/.expo' '**/.turbo'",
    "dev": "bun clean; watchman shutdown-server; turbo dev",
    "knip": "knip",
    "lint": "bunx ultracite fix",
    "nuke": "bun clean '**/node_modules' bun.lock",
    "prepare": "husky",
    "tunnel": "ngrok http --url=acorn-blue.ngrok.app 3000",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "turbo": "2.11.9",
    "typescript": "^6.0.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "ffmpeg-kit-react-native@6.0.2": "patches/ffmpeg-kit-react-native@6.0.2.patch",
    "react-native-nano-icons@1.0.1": "patches/react-native-nano-icons@1.0.1.patch"
  }
}
